# HealthTrack Environment Variables
# Copy this file to .env.local for local development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/healthtrack?schema=public"

# NextAuth Configuration
NEXTAUTH_SECRET="generate-a-random-secret-here-use-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers (Optional - for social login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Encryption Key (32 characters for AES-256)
ENCRYPTION_KEY="generate-32-char-key-for-encryption"

# Anthropic AI (if using AI features)
ANTHROPIC_API_KEY=""

# Email/SMTP (Optional)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@healthtrack.app"

# Environment
NODE_ENV="development"
